    "express": "^5.3.0",
    "jsdom": "23.2.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "5.5.207",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "pdfkit": "^0.20.2",
    "playwright": "^1.64.1"
  }
