# Optional. AltPass works with none of these set (rule-based alt text, flagged for human review).
# Copy to your shell environment (the app reads process.env; it does not load .env files by itself):
#   export OPENAI_API_KEY=...   then   npm start
# ALTPASS_LLM=rules|openai|anthropic     (default: openai if OPENAI_API_KEY is set, else anthropic if ANTHROPIC_API_KEY is set, else rules)
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1      (any OpenAI-compatible server)
# ALTPASS_VISION_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# PORT=3000
# HOST=127.0.0.1
